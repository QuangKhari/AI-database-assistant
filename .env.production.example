# Copy this file to .env.production on the server and replace every placeholder.
# Never commit .env.production.

MYSQL_ROOT_PASSWORD=replace_with_a_unique_mysql_root_password
SYSTEM_DB_NAME=ai_db_assistant_system
SYSTEM_DB_USERNAME=aidb_app
SYSTEM_DB_PASSWORD=replace_with_a_unique_application_database_password

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION_MS=86400000
AES_KEY=replace_with_a_16_24_or_32_byte_key

FRONTEND_BASE_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
BACKEND_HOST_PORT=8080

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

TARGET_DB_CONNECTION_TIMEOUT_MS=20000
TARGET_DB_CONNECTION_TIMEOUT_MAX_MS=30000
TARGET_DB_SOCKET_TIMEOUT_MS=30000
TARGET_DB_MAX_CONNECTIONS_PER_USER=5
TARGET_DB_MAX_TESTS_PER_MINUTE=10
QUERY_DEFAULT_TIMEOUT_SECONDS=20
QUERY_MAX_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=500
ALLOW_PRIVATE_TARGET_HOSTS=false

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_one_time_admin_password
ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator

JPA_DDL_AUTO=update
