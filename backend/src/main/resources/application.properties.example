spring.application.name=aidatabaseassistant
spring.datasource.url=jdbc:mysql://127.0.0.1:3308/ai_db_assistant_system
spring.datasource.username=root
spring.datasource.password=your_root_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

app.encryption.secret=MyAppSecretKey16

jwt.secret=ThisIsASecretKeyForJWTSigningPleaseChangeInProduction123456
jwt.expiration=86400000

gemini.api.key=${GEMINI_API_KEY}
gemini.api.url=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent