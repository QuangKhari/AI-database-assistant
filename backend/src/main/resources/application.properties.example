spring.application.name=aidatabaseassistant
server.port=8080
spring.datasource.url=${SYSTEM_DB_URL:jdbc:mysql://127.0.0.1:3308/ai_db_assistant_system?createDatabaseIfNotExist=true&serverTimezone=UTC}
spring.datasource.username=${SYSTEM_DB_USERNAME:root}
spring.datasource.password=${MYSQL_ROOT_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

app.encryption.secret=${AES_KEY}

app.target-db.connection-timeout-ms=${TARGET_DB_CONNECTION_TIMEOUT_MS:20000}
app.target-db.max-connection-timeout-ms=${TARGET_DB_CONNECTION_TIMEOUT_MAX_MS:30000}
app.target-db.socket-timeout-ms=${TARGET_DB_SOCKET_TIMEOUT_MS:30000}
app.target-db.max-connections-per-user=${TARGET_DB_MAX_CONNECTIONS_PER_USER:5}
app.target-db.max-tests-per-minute=${TARGET_DB_MAX_TESTS_PER_MINUTE:10}
app.target-db.allow-private-hosts=${ALLOW_PRIVATE_TARGET_HOSTS:true}

app.admin.bootstrap.enabled=${ADMIN_BOOTSTRAP_ENABLED:false}
app.admin.bootstrap.username=${ADMIN_BOOTSTRAP_USERNAME:}
app.admin.bootstrap.email=${ADMIN_BOOTSTRAP_EMAIL:}
app.admin.bootstrap.password=${ADMIN_BOOTSTRAP_PASSWORD:}
app.admin.bootstrap.display-name=${ADMIN_BOOTSTRAP_DISPLAY_NAME:Quản trị viên}

jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION_MS:86400000}

app.frontend.base-url=${FRONTEND_BASE_URL:http://localhost:5173}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}
app.password-reset.expiration-minutes=${PASSWORD_RESET_EXPIRATION_MINUTES:30}
app.password-reset.max-requests-per-hour=${PASSWORD_RESET_MAX_REQUESTS_PER_HOUR:3}

spring.mail.host=${MAIL_HOST:localhost}
spring.mail.port=${MAIL_PORT:1025}
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false

openai.api-key=${OPENAI_API_KEY:}
openai.model=${OPENAI_MODEL:gpt-4.1-mini}
openai.base-url=${OPENAI_BASE_URL:https://api.openai.com/v1}
openai.timeout-seconds=${OPENAI_TIMEOUT_SECONDS:30}
